// MyNextMovie app target.

PRODUCT_NAME = $(TARGET_NAME)
// Change to your own identifier to run the app on an iPhone.
PRODUCT_BUNDLE_IDENTIFIER = com.fwsoft.MyNextMovie

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = My Next Movie
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
SWIFT_EMIT_LOC_STRINGS = YES

// App code runs on the main actor unless marked nonisolated.
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// The Lint build phase reads the source folders.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// API keys. Real values go in Secrets.xcconfig, which is not committed.
TMDB_API_KEY =
SUPABASE_URL =
SUPABASE_ANON_KEY =

#include? "Secrets.xcconfig"

// Without this text iOS does not ask for the location, and the app quits when it asks.
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = My Next Movie shows the cinemas near you on the map.
